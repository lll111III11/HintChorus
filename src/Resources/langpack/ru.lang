# ── мастер первой настройки ────────────────────────────────────
setup.banner = Первичная настройка HintChorus
setup.detected = Обнаружено: язык={0} | часовой пояс={1} | регион={2}
setup.detectedExtra = Источник часового пояса: {0} | Проверка времени: {1}
setup.srcNetwork = публичный IP + сетевой пояс
setup.srcLocal = локальный пояс
setup.clockOk = локальное время достоверно
setup.clockSkew = отклонение {0} с
setup.q1 = 1) Включить автообновление? сейчас: {0}
setup.q2 = 2) Включить подробный журнал UI? сейчас: {0}
setup.q3 = 3) Перезапускать сервер после раунда при обновлении (RNR)? сейчас: {0}
setup.q4 = 4) Записать конфигурацию сейчас? сейчас: {0}
setup.desc1 = Автообновление: проверяет GitHub Releases; при включении скачивает автоматически, но по умолчанию сохраняет только HintChorus.dll.new.
setup.desc2 = Подробный журнал UI: записывает текст, позицию и итоговый вывод по игрокам в logs/ui-*.log; заметная нагрузка на диск.
setup.desc3 = Перезапуск после раунда (RNR): после скачивания и замены DLL полностью перезапускает сервер по окончании текущего раунда.
setup.desc4 = Записать конфигурацию: сохраняет текущие настройки в config.yml для следующих запусков.
setup.commands = Hc setup done — завершить | Hc setup skip — пропустить
setup.step = Шаг {0}/{1}
setup.answer = Ответ: Hc setup да / Hc setup нет    (также Hc да / Hc нет; Hc setup 1 on|off задаёт пункт напрямую)
setup.q5 = 5) Оставить HintChorus с полным перехватом? сейчас: {0}
setup.desc5 = Полный перехват (пред-обновление): снимает патчи других hint-фреймворков, включает полное управление UI-пакетами (чужие UI-пакеты обнуляются в памяти) и мгновенно повторяет UI этого слоя из снимка. Вручную: Hint preop.
setup.q6 = 6) Включить подробную настройку всех параметров? сейчас: {0}
setup.desc6 = Подробная настройка: все параметры (кроме указанных выше) запрашиваются по одному. Можно задать оставшиеся по умолчанию, пропустить их или сохранить прогресс и продолжить при следующем запуске.
