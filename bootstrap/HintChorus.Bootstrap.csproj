<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  HintChorus 引导 payload。
	  由永久 shim(0.dll)从 plugins\global\HintChorus.Bootstrap.payload 以字节载入。
	  本工程只引用 LabApi, 不做插件注册; 更新时只替换 payload, 0.dll 保持不动。
	-->

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>HintChorus.Bootstrap.Payload</AssemblyName>
		<RootNamespace>HintChorus.Bootstrap</RootNamespace>
		<Version>1.0.2</Version>
		<!-- 改动引导逻辑时必须同时提升 Version:
		     主插件按程序集版本判断是否需要更新 payload。 -->
		<Deterministic>true</Deterministic>
		<PlatformTarget>x64</PlatformTarget>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
	</PropertyGroup>

	<PropertyGroup>
		<ManagedDir>D:\SteamLibrary\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed</ManagedDir>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="LabApi">
			<HintPath>$(ManagedDir)\LabApi.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="netstandard">
			<HintPath>$(ManagedDir)\netstandard.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- 映射组件: 由 0.dll 释放到 dependencies\global, 下一次重启由 LabAPI 预加载 -->
		<EmbeddedResource Include="..\mapping\bin\$(Configuration)\net48\HintChorus.Mapping.dll">
			<LogicalName>HintChorus.Mapping.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="..\mapping\bin\$(Configuration)\net48\template-map.ini">
			<LogicalName>HintChorus.Mapping.template-map.ini</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<!-- 只保证构建顺序, 不作为程序集引用 -->
		<ProjectReference Include="..\mapping\HintChorus.Mapping.csproj" ReferenceOutputAssembly="false" />
	</ItemGroup>

</Project>
