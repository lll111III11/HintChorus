# ══════════════════════════════════════════════════════════════════
# HintChorus runtime language pack — English (canonical)
#
# This file is embedded into HintChorus.dll. To override any line,
# copy it to:  configs/<port>/HintChorus/lang/en.lang
# and edit the value; keys are matched case-insensitively.
#
# Format:  key = value
# Escapes: \n  \r  \t  \\
# Comments: lines starting with # ; or //
# ══════════════════════════════════════════════════════════════════

# ── first-run setup wizard ───────────────────────────────────────
setup.banner = HintChorus first-run setup
setup.detected = Detected: language={0} | timezone={1} | region={2}
setup.detectedExtra = Time zone source: {0} | Clock check: {1}
setup.srcNetwork = public IP + network time zone
setup.srcLocal = local time zone
setup.clockOk = local clock trusted
setup.clockSkew = local clock off by {0}s
setup.q1 = 1) Enable auto update? current: {0}
setup.q2 = 2) Enable detailed UI log? current: {0}
setup.q3 = 3) Restart at the end of the round after an update (RNR)? current: {0}
setup.q4 = 4) Write the configuration now? current: {0}
setup.desc1 = Auto update: checks GitHub Releases; when enabled it downloads automatically, but only saves HintChorus.dll.new by default.
setup.desc2 = Detailed UI log: records each plugin's text, screen position and per-player composite into logs/ui-*.log; noticeable IO cost.
setup.desc3 = Restart after round (RNR): after the update is downloaded and the DLL is replaced, fully restart the server at the end of the current round to load it.
setup.desc4 = Write config: saves the current choices to config.yml so they persist across restarts.
setup.commands = Hc setup done to finish | Hc setup skip to skip
setup.step = Step {0}/{1}
setup.answer = Answer: Hc setup yes / Hc setup no    (Hc yes / Hc no also works; Hc setup 1 on|off sets one item directly)
setup.on = on
setup.off = off
setup.yes = yes
setup.no = no
setup.saved = Config saved: {0}
setup.skipped = Skipped. Nothing was changed.
setup.done = Setup complete.
setup.restart = Detailed log and similar settings take full effect after restart.
setup.notActive = The setup wizard is not running (already done or not started).
setup.usage = Usage: Hc setup | Hc setup yes|no | Hc setup <1-4> on|off|yes|no | Hc setup done | Hc setup skip
setup.failed = setup failed: {0}
setup.notInitialized = config not initialized
setup.writeConfigFailed = failed to write config: {0}
setup.writeStateFailed = failed to write setup state: {0}

# ── server console commands ──────────────────────────────────────
cmd.description = HintChorus server console: Hint orvs detects mainstream plugins and falls back to native hints
cmd.helpHeader = [HintChorus] console commands (case-insensitive):
cmd.helpOrvs = Hint orvs — detect mainstream plugins and list numbers (option 1 = native when none)
cmd.helpPick = Hint orvs <n> — switch that plugin to native and replay its last data
cmd.helpMerge = Hint orvs <n> merge — restore that plugin to merged rendering
cmd.helpNative = Hint orvs native — switch everything to native and replay pre-override data
cmd.helpAll = Hint orvs all — switch all plugins to native and replay
cmd.helpReset = Hint orvs reset — leave native mode and restore merged rendering
cmd.helpYield = Hint orvs yield — hand the hint channel to external plugins (this run only)
cmd.helpTake = Hint orvs take — reclaim the hint channel (default)
cmd.helpSetup = Hc setup — first-run setup (auto update / detailed log / write config / RNR)
cmd.helpUpdate = Hc update — check the latest GitHub release now
cmd.helpLang = Hint lang [reload|path] — list language packs, reload external packs, or show the lang directory
cmd.helpFooter = Note: multiple hint plugins can coexist; use orvs to roll back one plugin without affecting the others.
cmd.consoleOnly = [HintChorus] This command is only allowed on the server terminal console.
cmd.unknown = [HintChorus] Unknown subcommand: {0}\n{1}
cmd.yield = [HintChorus] Hint channel handed over: external hint plugins may take control now.\nRun Hint orvs take to reclaim it.
cmd.take = [HintChorus] Hint channel reclaimed: this layer is in control again and has re-sent the UI.
cmd.native = [HintChorus] Switched everything to native hints and restored pre-override data for {0} players.\nRun Hint orvs reset to restore merged rendering.
cmd.nativeNone = [HintChorus] No mainstream plugins detected; option 1 switched everything to native hints and restored pre-override data for {0} players.\nRun Hint orvs reset to restore merged rendering.
cmd.all = [HintChorus] Switched {0} plugins to native pass-through ({1} detected) and restored pre-override data for {2} players.\nRun Hint orvs reset to restore all merged rendering.
cmd.reset = [HintChorus] Left native mode; restored merged rendering for {0} plugins.
cmd.invalidNumber = [HintChorus] The number must be numeric.\n{0}
cmd.outOfRange = [HintChorus] Number out of range: {0} (valid range {1}-{2}).
cmd.mergeOne = [HintChorus] Restored {0} to merged rendering.
cmd.nativeOne = [HintChorus] Switched {0} to native pass-through and hot-applied the last data for {1} players.\nOther plugins are still managed by the merge layer; restore with: Hint orvs {2} merge
cmd.alreadyNative = \n(this plugin was already on native pass-through)
cmd.execFailed = [HintChorus] Command failed: {0}
cmd.registered = [HintChorus] Console command ready: Hint orvs (case-insensitive)
cmd.registerFailed = [HintChorus] Failed to register console command Hint (retrying every 5 seconds): {0}
cmd.list.noMainstream = [HintChorus] No mainstream Hint plugins detected.
cmd.list.nativeOption =   1) Fall back to native (restore pre-override data)
cmd.list.others = Other detected plugins:
cmd.list.stateNative =   [native]
cmd.list.stateMerged =   [merged]
cmd.list.noMainstreamHint = Enter Hint orvs 1 to fall back to native; enter Hint orvs <n> to switch a single plugin.
cmd.list.resetHint = Restore merged rendering: Hint orvs reset
cmd.list.header = [HintChorus] Detected {0} mainstream Hint plugins{1}:
cmd.list.nativeModeSuffix =  (currently in global native mode)
cmd.list.pickHint = Enter Hint orvs <n> to switch it to native pass-through and hot-apply its last data; add merge to restore.
cmd.list.nativeAllHint = Fall back everything to native: Hint orvs native | Restore all: Hint orvs reset

