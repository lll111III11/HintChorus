# ── 服务器控制台命令 ─────────────────────────────────────────────
cmd.description = HintChorus 服务器控制台: Hint orvs 检测主流插件并切回原生提示
cmd.helpHeader = [HintChorus] 控制台命令(大小写不敏感):
cmd.helpOrvs = Hint orvs — 检测主流插件并列出编号(无主流时编号 1 = 退回原生)
cmd.helpPick = Hint orvs <编号> — 把该插件切回原生直通, 并热应用其最后一条数据
cmd.helpMerge = Hint orvs <编号> merge — 恢复该插件为合并渲染
cmd.helpNative = Hint orvs native — 整体退回原生, 恢复覆盖前数据
cmd.helpAll = Hint orvs all — 全部退回原生并恢复覆盖前数据
cmd.helpReset = Hint orvs reset — 退出原生模式, 全部恢复合并
cmd.helpYield = Hint orvs yield — 让出提示通道, 允许外部 Hint 插件接管(仅本次运行)
cmd.helpTake = Hint orvs take — 收回提示通道, 恢复本底层接管(默认)
cmd.helpSetup = Hc setup — 首次运行配置向导(自动更新/详细日志/写入配置/RNR)
cmd.helpUpdate = Hc update — 立即检查 GitHub 最新版本
cmd.helpLang = Hint lang [reload|path] — 查看语言包、重载外部语言包或显示语言包目录
cmd.helpPreOp = Hint preop [on|off|status] — 预更新实操作: 摘外部补丁 + 全网络包管理 + 瞬间快照重发

# ── 预更新实操作(全网络包管理) ──────────────────────────────────
