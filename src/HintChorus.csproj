<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 与游戏服务器一致: .NET Framework 4.8 -->
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>HintChorus</AssemblyName>
		<RootNamespace>HintChorus</RootNamespace>
		<Version>1.0.0</Version>
		<PlatformTarget>x64</PlatformTarget>
		<!-- 只允许可空注解, 不因历史代码触发成百条空引用告警 -->
		<Nullable>annotations</Nullable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- 版本信息由 Properties\AssemblyInfo.cs 提供, 不让 SDK 再生成一份 -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<PropertyGroup>
		<!-- SCP:SL 专用服务器 Managed 目录(按需改成自己的服务器路径) -->
		<ManagedDir>D:\SteamLibrary\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed</ManagedDir>
	</PropertyGroup>

	<ItemGroup>
		<!-- 备份目录与还原参考件不进编译 -->
		<Compile Remove="_backup_20261004\**" />
		<Compile Remove="_ref_from_deploy\**" />
		<None Remove="_backup_20261004\**" />
		<None Remove="_ref_from_deploy\**" />
		<EmbeddedResource Remove="_backup_20261004\**" />
		<EmbeddedResource Remove="_ref_from_deploy\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- 游戏与框架引用(Private=false 不随插件复制) -->
		<Reference Include="LabApi">
			<HintPath>$(ManagedDir)\LabApi.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Assembly-CSharp-firstpass">
			<HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Mirror">
			<HintPath>$(ManagedDir)\Mirror.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NorthwoodLib">
			<HintPath>$(ManagedDir)\NorthwoodLib.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="netstandard">
			<HintPath>$(ManagedDir)\netstandard.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="YamlDotNet">
			<HintPath>$(ManagedDir)\YamlDotNet.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<!-- 在 Windows 上构建 net48 所需的引用程序集(仅编译期) -->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- 提示条文本度量表: 代码按这个 LogicalName 读取, 名字不能改
		     (原生提示的 5 种内嵌译文在 NativeHintTranslator 里, 其余语言走 translations\ 目录) -->
		<EmbeddedResource Include="Resources\HintChorus.textwidth.bin">
			<LogicalName>HintChorus.textwidth.bin</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<!-- ══════════════════════════════════════════════════════════════
		     抢占最先头: 把 0 前缀引导器的构建产物作为嵌入资源打进本程序集,
		     运行时由 BootstrapInstaller 释放为
		     plugins\global\0HintChorus.Bootstrap.dll
		     ══════════════════════════════════════════════════════════════ -->
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)..\bootstrap\bin\$(Configuration)\net48\HintChorus.Bootstrap.dll">
			<LogicalName>HintChorus.Bootstrap.dll</LogicalName>
		</EmbeddedResource>
		<!-- 仅用于保证引导器先于本工程构建, 不作为程序集引用 -->
		<ProjectReference Include="..\bootstrap\HintChorus.Bootstrap.csproj"
		                  ReferenceOutputAssembly="false"
		                  Private="false" />
	</ItemGroup>

</Project>
