<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- 与游戏服务器一致: .NET Framework 4.8 -->
		<TargetFramework>net48</TargetFramework>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<AssemblyName>HintChorus</AssemblyName>
		<RootNamespace>HintChorus</RootNamespace>
		<!-- 版本与游戏对齐: <游戏 Major>.<游戏 Minor>.<游戏 Revision>.<插件构建号>
		     当前游戏版本 14.2.9 (GameCore.Version); 游戏更新时前三段跟随, 第四段归零。 -->
		<Version>14.2.9.1</Version>
		<Deterministic>true</Deterministic>
		<PlatformTarget>x64</PlatformTarget>
		<!-- 只允许可空注解, 不因历史代码触发成百条空引用告警 -->
		<Nullable>annotations</Nullable>
		<GenerateDocumentationFile>false</GenerateDocumentationFile>
		<!-- 版本信息由 Properties\AssemblyInfo.cs 提供, 不让 SDK 再生成一份 -->
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	</PropertyGroup>

	<PropertyGroup>
		<!-- SCP:SL 专用服务器 Managed 目录(按需改成自己的服务器路径) -->
		<ManagedDir>D:\SteamLibrary\steamapps\common\SCP Secret Laboratory Dedicated Server\SCPSL_Data\Managed</ManagedDir>
	</PropertyGroup>

	<ItemGroup>
		<!-- 备份目录与还原参考件不进编译 -->
		<Compile Remove="_backup_20261004\**" />
		<Compile Remove="_ref_from_deploy\**" />
		<None Remove="_backup_20261004\**" />
		<None Remove="_ref_from_deploy\**" />
		<EmbeddedResource Remove="_backup_20261004\**" />
		<EmbeddedResource Remove="_ref_from_deploy\**" />
	</ItemGroup>

	<ItemGroup>
		<!-- 游戏与框架引用(Private=false 不随插件复制) -->
		<Reference Include="LabApi">
			<HintPath>$(ManagedDir)\LabApi.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Assembly-CSharp-firstpass">
			<HintPath>$(ManagedDir)\Assembly-CSharp-firstpass.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Mirror">
			<HintPath>$(ManagedDir)\Mirror.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="NorthwoodLib">
			<HintPath>$(ManagedDir)\NorthwoodLib.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.TextMeshPro">
			<HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="netstandard">
			<HintPath>$(ManagedDir)\netstandard.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="YamlDotNet">
			<HintPath>$(ManagedDir)\YamlDotNet.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(ManagedDir)\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<!-- 服务器控制台命令(Hint orvs)所需的命令系统程序集 -->
		<Reference Include="CommandSystem.Core">
			<HintPath>$(ManagedDir)\CommandSystem.Core.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<!-- 在 Windows 上构建 net48 所需的引用程序集(仅编译期) -->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<!-- 提示条文本度量表: 代码按这个 LogicalName 读取, 名字不能改
		     (原生提示的 5 种内嵌译文在 NativeHintTranslator 里, 其余语言走 translations\ 目录) -->
		<EmbeddedResource Include="Resources\HintChorus.textwidth.bin">
			<LogicalName>HintChorus.textwidth.bin</LogicalName>
		</EmbeddedResource>
		<!-- 运行时语言包: 内嵌五语, 外部 configs/<端口>/HintChorus/lang/<code>.lang 逐 key 覆盖 -->
		<EmbeddedResource Include="Resources\langpack\*.lang">
			<LogicalName>HintChorus.lang.%(Filename).lang</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<!-- ══════════════════════════════════════════════════════════════
		     单文件发放: 主 DLL 内嵌 永久 shim + 引导 payload + 映射组件。
		     首次运行全部释放, 提示重启一次; 重启后 shim 载入 payload,
		     payload 再做抢先安装。以后只替换 payload, 0.dll 永远不动。
		     ══════════════════════════════════════════════════════════════ -->
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)..\bootstrap-shim\bin\$(Configuration)\net48\HintChorus.Shim.dll">
			<LogicalName>HintChorus.Shim.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)..\bootstrap\bin\$(Configuration)\net48\HintChorus.Bootstrap.Payload.dll">
			<LogicalName>HintChorus.Bootstrap.Payload.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)..\mapping\bin\$(Configuration)\net48\HintChorus.Mapping.dll">
			<LogicalName>HintChorus.Mapping.dll</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="$(MSBuildThisFileDirectory)..\mapping\bin\$(Configuration)\net48\template-map.ini">
			<LogicalName>HintChorus.Mapping.template-map.ini</LogicalName>
		</EmbeddedResource>
		<!-- 仅用于保证构建顺序, 不作为程序集引用 -->
		<ProjectReference Include="..\mapping\HintChorus.Mapping.csproj"
		                  ReferenceOutputAssembly="false"
		                  Private="false" />
		<ProjectReference Include="..\bootstrap\HintChorus.Bootstrap.csproj"
		                  ReferenceOutputAssembly="false"
		                  Private="false" />
		<ProjectReference Include="..\bootstrap-shim\HintChorus.Shim.csproj"
		                  ReferenceOutputAssembly="false"
		                  Private="false" />
	</ItemGroup>

</Project>
