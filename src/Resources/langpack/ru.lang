# ── команды консоли сервера ────────────────────────────────────
cmd.description = Консоль сервера HintChorus: Hint orvs находит популярные плагины и возвращает нативные подсказки
cmd.helpHeader = [HintChorus] команды консоли (без учёта регистра):
cmd.helpOrvs = Hint orvs — найти популярные плагины и показать номера (1 = нативный режим, если их нет)
cmd.helpPick = Hint orvs <n> — переключить этот плагин на нативный вывод и повторить последние данные
cmd.helpMerge = Hint orvs <n> merge — вернуть этот плагин в объединённый рендер
cmd.helpNative = Hint orvs native — всё на нативный вывод и повтор данных
cmd.helpAll = Hint orvs all — все плагины на нативный вывод и повтор
cmd.helpReset = Hint orvs reset — выйти из нативного режима и вернуть объединение
cmd.helpYield = Hint orvs yield — отдать канал внешним плагинам (только на этот запуск)
cmd.helpTake = Hint orvs take — вернуть канал (по умолчанию)
cmd.helpSetup = Hc setup — первичная настройка (автообновление / подробный журнал / запись конфига / RNR)
cmd.helpUpdate = Hc update — проверить последнюю версию GitHub сейчас
cmd.helpLang = Hint lang [reload|path] — список языковых пакетов, перезагрузка внешних пакетов или путь к папке
cmd.helpPreOp = Hint preop [on|off|status] — пред-обновление: снять чужие патчи, полное управление UI-пакетами, мгновенный повтор

# ── пред-обновление (полное управление UI-пакетами) ─────────────
preop.engaged = [HintChorus] Пред-обновление включено: снято групп патчей — {0}, повторено игрокам — {1}. Остальные UI-пакеты теперь обнуляются в памяти. Hint preop off — отключить.
preop.disengaged = [HintChorus] Полное управление UI-пакетами выключено. Снятые патчи не вернутся до перезапуска.
preop.failed = [HintChorus] Ошибка пред-обновления: {0}
preop.failedShort = [HintChorus] Ошибка пред-обновления; подробности в журнале отчётов.
preop.report = пред-обновление: снято групп — {0}, повторено игрокам — {1}
preop.off = пред-обновление выключено
preop.statusOn = [HintChorus] Пред-обновление ВКЛ · снято групп: {0} · обнулено подсказок: {1} · обнулено broadcast: {2} · обнулено CASSIE: {3}
preop.statusOff = [HintChorus] Пред-обновление ВЫКЛ.
preop.usage = Использование: Hint preop [on|off|status]
cmd.helpFooter = Примечание: несколько hint-плагинов могут работать вместе; orvs откатывает один, не затрагивая остальные.
cmd.consoleOnly = [HintChorus] Эта команда разрешена только в консоли терминала сервера.
cmd.unknown = [HintChorus] Неизвестная подкоманда: {0}\n{1}
cmd.yield = [HintChorus] Канал подсказок передан: внешние hint-плагины могут им управлять.\nВведите Hint orvs take, чтобы вернуть.
cmd.take = [HintChorus] Канал подсказок возвращён: этот слой снова управляет и повторно отправил UI.
cmd.native = [HintChorus] Всё переведено на нативные подсказки; данные до перехвата восстановлены для {0} игроков.\nВведите Hint orvs reset для объединённого рендера.
cmd.nativeNone = [HintChorus] Популярные плагины не найдены; вариант 1 перевёл всё на нативные подсказки и восстановил данные {0} игроков.\nВведите Hint orvs reset для объединённого рендера.
cmd.all = [HintChorus] {0} плагинов переведены на нативный вывод (всего найдено {1}); данные восстановлены для {2} игроков.\nВведите Hint orvs reset, чтобы вернуть объединение.
cmd.reset = [HintChorus] Нативный режим отключён; объединённый рендер восстановлен для {0} плагинов.
cmd.invalidNumber = [HintChorus] Номер должен быть числом.\n{0}
cmd.outOfRange = [HintChorus] Номер вне диапазона: {0} (допустимо {1}-{2}).
cmd.mergeOne = [HintChorus] {0} возвращён в объединённый рендер.
cmd.nativeOne = [HintChorus] {0} переведён на нативный вывод; последние данные применены для {1} игроков.\nОстальные плагины по-прежнему в слое объединения; вернуть: Hint orvs {2} merge
